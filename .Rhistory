cleanup_files <- function() {
# 删除构建文件
if (dir.exists("src")) {
file.remove(
list.files("src", pattern = "\\.o$|\\.so$|\\.dll$|\\.def$", full.names = TRUE)
)
}
# 删除 RcppExports 文件
if (file.exists("src/RcppExports.cpp")) file.remove("src/RcppExports.cpp")
if (file.exists("R/RcppExports.R")) file.remove("R/RcppExports.R")
# 删除文档文件
if (dir.exists("man")) {
file.remove(list.files("man", full.names = TRUE))
}
# 删除 NAMESPACE
if (file.exists("NAMESPACE")) file.remove("NAMESPACE")
# 删除已安装的包
pkg_path <- "C:/Users/jad/AppData/Local/R/win-library/4.5/SA25204160"
if (dir.exists(pkg_path)) {
unlink(pkg_path, recursive = TRUE, force = TRUE)
}
cat("清理完成！\n")
}
