# 3. 检查并修复R代码中的非ASCII字符
fix_non_ascii <- function() {
r_files <- list.files("R", pattern = "\\.R$", full.names = TRUE)
for (file in r_files) {
content <- readLines(file, encoding = "UTF-8")
# 检查非ASCII字符
non_ascii <- grep("[^\\x00-\\x7F]", content, perl = TRUE)
if (length(non_ascii) > 0) {
cat(sprintf("文件 %s 有非ASCII字符，行: %s\n", file, paste(non_ascii, collapse = ", ")))
# 用ASCII替换常见中文标点
content <- gsub("，", ",", content)
content <- gsub("。", ".", content)
content <- gsub("；", ";", content)
content <- gsub("：", ":", content)
content <- gsub("！", "!", content)
content <- gsub("？", "?", content)
content <- gsub("（", "(", content)
content <- gsub("）", ")", content)
writeLines(content, file, useBytes = TRUE)
}
}
}
fix_non_ascii()
