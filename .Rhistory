install()
x <- seq(-pi, pi, length.out = 100)
sin_x <- sin(x)
taylor_3 <- x - x^3/factorial(3)
taylor_5 <- x - x^3/factorial(3) + x^5/factorial(5)
df <- data.frame(x, sin_x, taylor_3, taylor_5)
# 绘制图形
library(ggplot2)
p <- ggplot(df, aes(x = x)) +
geom_line(aes(y = sin_x, color = "sin(x)"), size = 1) +
geom_line(aes(y = taylor_3, color = "3阶泰勒近似"), linetype = "dashed") +
geom_line(aes(y = taylor_5, color = "5阶泰勒近似"), linetype = "dashed") +
labs(title = "sin(x)及其泰勒级数近似",
x = "x", y = "y") +
scale_color_manual(values = c("sin(x)" = "black",
"3阶泰勒近似" = "blue",
"5阶泰勒近似" = "red")) +
theme_minimal()
print(p)
