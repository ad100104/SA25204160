library(SA25204160)
# 模拟金融数据（2个特征列，1000行，保留原本的测试数据逻辑）
financial_data <- data.frame(
price_change = rnorm(1000, mean = 0, sd = 1),
volume = rnorm(1000, mean = 10000, sd = 500)
)
# 计算分位数（移除batch_size参数，仅核心参数）
quantile_result <- cpp_quantile_calc(financial_data, c("price_change", "volume"))
print("分位数结果（0.01, 0.5, 0.99）：")
quantile_result
# 添加目标列（模拟收益率，保留原本的测试数据逻辑）
financial_data$target_return <- rnorm(1000, mean = 0.02, sd = 0.01)
# 训练模型（移除epochs参数，仅核心参数，保留原本的训练逻辑）
model <- train_residual_mlp(financial_data, target_col = "target_return")
print("模型训练完成（核心逻辑版）！")
